<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:windowBackground"
    android:paddingTop="@dimen/spacing_large"
    android:paddingBottom="@dimen/spacing_large"
    android:paddingStart="@dimen/spacing_x_large"
    android:paddingEnd="@dimen/spacing_x_large"
    android:gravity="center_vertical">

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        app:srcCompat="@drawable/ic_topic"
        android:tint="?android:textColorSecondary"/>

    <TextView
        android:id="@+id/topic_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="?android:textColorPrimary"
        android:textSize="@dimen/text_normal"
        android:layout_marginStart="@dimen/spacing_large"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_my_topic"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="@dimen/spacing_large"
        android:visibility="gone"
        android:contentDescription="@string/my_topics"
        app:srcCompat="@drawable/ic_done_title"
        android:tint="?colorAccent"
        tools:visibility="visible"/>

</LinearLayout>
